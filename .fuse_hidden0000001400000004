<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Contact — Tricil Packaging</title>
  <meta name="description" content="Get in touch with Tricil Packaging Pvt. Ltd. — Vasai, Maharashtra. Request a quote for BOPP films, cartons, pouches and rolls." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="css/style.css" />
</head>
<body>

  <div class="blobs">
    <div class="blob blob--1"></div>
    <div class="blob blob--2"></div>
    <div class="blob blob--3"></div>
  </div>
  <div class="grain"></div>

  <!-- TOP BAR -->
  <div class="topbar">
    <div class="container">
      <div class="topbar__time"><b>Working time:</b> Monday to Friday · 9 AM – 5 PM</div>
      <div class="topbar__social">
        <a href="#" aria-label="Facebook">f</a><a href="#" aria-label="Instagram">◎</a><a href="#" aria-label="Twitter">𝕏</a><a href="#" aria-label="LinkedIn">in</a>
      </div>
    </div>
  </div>

  <nav class="nav">
    <a href="index.html" class="nav__logo"><img src="Assets/images/logo.png" alt="Tricil — Complete Packaging Solutions" /></a>
    <div class="nav__links">
      <a href="index.html">Home</a>
      <a href="about.html">About</a>
      <span class="has-drop">
        <a href="products.html">Products</a>
        <div class="dropdown">
          <a href="products.html#bopp">BOPP Films</a>
          <a href="products.html#cartons">Printed Cartons</a>
          <a href="products.html#pouches">Laminated Pouches</a>
          <a href="products.html#rolls">Printed Rolls</a>
          <a href="products.html">All Products →</a>
        </div>
      </span>
      <a href="about.html#certifications">Certificates</a>
      <a href="index.html#portfolio">Portfolio</a>
      <a href="contact.html">Contact</a>
      <a href="contact.html" class="btn btn-primary nav__cta">Request A Quote <span class="arrow">→</span></a>
    </div>
    <button class="nav__burger" aria-label="Menu"><span></span><span></span><span></span></button>
  </nav>

  <!-- PAGE HERO -->
  <header class="page-hero" style="padding-bottom:2rem">
    <div class="container">
      <span class="eyebrow reveal" style="justify-content:center">Get in touch</span>
      <h1 data-splt>Let's talk packaging.</h1>
      <p class="lead reveal">Tell us your requirement — size, material, print — and we'll get back with a quote fast.</p>
    </div>
  </header>

  <!-- CONTACT GRID -->
  <section style="padding-top:2rem">
    <div class="container">
      <div class="split" style="align-items:stretch">

        <!-- Form -->
        <div class="glass reveal" style="padding:clamp(1.8rem,4vw,2.8rem)">
          <h3 style="margin-bottom:1.4rem">Request a quote</h3>
          <form class="form" id="contact-form">
            <div class="field">
              <label for="name">Name</label>
              <input id="name" name="name" type="text" placeholder="Your name" required />
            </div>
            <div class="grid grid-2" style="gap:1.1rem">
              <div class="field">
                <label for="email">Email</label>
                <input id="email" name="email" type="email" placeholder="you@company.com" required />
              </div>
              <div class="field">
                <label for="phone">Phone</label>
                <input id="phone" name="phone" type="tel" placeholder="+91 …" />
              </div>
            </div>
            <div class="field">
              <label for="product">Product of interest</label>
              <select id="product" name="product">
                <option>BOPP Films</option>
                <option>Printed Cartons</option>
                <option>Laminated Pouches</option>
                <option>Printed Rolls</option>
                <option>Other / Not sure</option>
              </select>
            </div>
            <div class="field">
              <label for="message">Your requirement</label>
              <textarea id="message" name="message" rows="4" placeholder="Size, material, quantity, print details…"></textarea>
            </div>
            <button type="submit" class="btn btn-primary" style="justify-content:center">Send request <span class="arrow">→</span></button>
          </form>
        </div>

        <!-- Info -->
        <div class="reveal">
          <div class="info-row">
            <div class="ic" style="background:var(--grad-coral)">📍</div>
            <div>
              <h4 style="margin-bottom:0.2rem">Head Office</h4>
              <p style="color:var(--ink-soft)">Unit #29, Sheetal Swapna Industrial Estate,<br />Bhoidapada Naka, Sativali Road, Vasai (East),<br />Dist. Palghar — 401208, Maharashtra, India</p>
            </div>
          </div>
          <div class="info-row">
            <div class="ic" style="background:var(--grad-lav)">✉️</div>
            <div>
              <h4 style="margin-bottom:0.2rem">Email</h4>
              <p style="color:var(--ink-soft)"><a href="mailto:info@tricil.in">info@tricil.in</a></p>
            </div>
          </div>
          <div class="info-row">
            <div class="ic" style="background:var(--grad-mint)">📞</div>
            <div>
              <h4 style="margin-bottom:0.2rem">Call us</h4>
              <p style="color:var(--ink-soft)"><a href="tel:+919821063408">+91 98210 63408</a></p>
            </div>
          </div>
          <div class="info-row">
            <div class="ic" style="background:var(--grad-sun)">🕒</div>
            <div>
              <h4 style="margin-bottom:0.2rem">Hours</h4>
              <p style="color:var(--ink-soft)">Mon – Sat, 9:30 AM – 6:30 PM</p>
            </div>
          </div>

          <!-- Google Map -->
          <div style="margin-top:1rem;border-radius:var(--radius);overflow:hidden;box-shadow:0 20px 50px rgba(18,34,63,0.18);border:1px solid rgba(255,255,255,0.6)">
            <iframe
              title="Tricil Packaging location — Vasai East"
              src="https://www.google.com/maps?q=Sheetal%20Swapna%20Industrial%20Estate%2C%20Sativali%20Road%2C%20Vasai%20East%2C%20Palghar%20401208&output=embed"
              width="100%" height="240" style="border:0;display:block" loading="lazy"
              referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="container">
      <div class="footer__top">
        <div class="footer__brand">
          <div class="logo"><span class="dot"></span> Tricil</div>
          <p>ISO 9001:2015 certified manufacturer of BOPP films, printed cartons, laminated pouches & rolls since 2005.</p>
        </div>
        <div><h4>Products</h4><ul><li><a href="products.html">BOPP Films</a></li><li><a href="products.html">Printed Cartons</a></li><li><a href="products.html">Laminated Pouches</a></li><li><a href="products.html">Printed Rolls</a></li></ul></div>
        <div><h4>Company</h4><ul><li><a href="about.html">About Us</a></li><li><a href="contact.html">Contact</a></li></ul></div>
        <div><h4>Reach us</h4><ul><li><a href="contact.html">Unit 29, Sheetal Swapna Ind. Estate, Vasai (E), Thane 401208</a></li></ul></div>
      </div>
      <div class="footer__bottom"><span>© 2026 Tricil Packaging Pvt. Ltd.</span><span>Made with colour ✳</span></div>
    </div>
  </footer>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/@studio-freight/lenis@1.0.42/dist/lenis.min.js"></script>
  <script src="js/animations.js"></script>
</body>
</html>
